@page
@using System.Text.Json
@model SAT.Frontend.Web.Pages.PeticionesModel
@{
    ViewData["Title"] = "Peticiones, Gráficas y PDF";
}

<div class="row mb-3">
    <div class="col-12">
        <h2 class="fw-bold text-primary">Peticiones, Gráficas y Reportes en PDF</h2>
        <p class="text-muted">Ejecuta cualquiera de las 3 consultas para visualizar los datos estadísticos, sus gráficas y exportar el reporte en formato PDF.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}

<div class="row g-4 mb-4">
    <!-- Consultar Contribuyente -->
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-primary">
            <div class="card-header bg-primary text-white fw-bold">
                1. Consultar Contribuyente
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="ConsultarContribuyente">
                    <div class="mb-2">
                        <label class="form-label fw-semibold">NIT del Contribuyente:</label>
                        <input type="text" asp-for="NitConsulta" class="form-control" placeholder="Ej. 7378106" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold">Tipo de Facturas:</label>
                        <select asp-for="TipoOperacion" class="form-select">
                            <option value="emitidas">Facturas Emitidas</option>
                            <option value="recibidas">Facturas Recibidas</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold">Fecha Inicio:</label>
                        <input type="date" asp-for="FechaInicioContribuyente" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Fecha Fin:</label>
                        <input type="date" asp-for="FechaFinContribuyente" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-bold">Consultar Contribuyente</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Resumen de IVA por Fecha y NIT -->
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-success">
            <div class="card-header bg-success text-white fw-bold">
                2. Resumen de IVA por Fecha y NIT
            </div>
            <div class="card-body d-flex flex-column justify-content-between">
                <form method="post" asp-page-handler="ResumenIva">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Seleccionar Fecha:</label>
                        <input type="date" asp-for="FechaResumenIva" class="form-control" required />
                        <div class="form-text">Muestra tabla y gráfica de IVA emitido e IVA recibido por cada NIT en esa fecha.</div>
                    </div>
                    <button type="submit" class="btn btn-success w-100 fw-bold mt-4">Generar Resumen y Gráfica de IVA</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Resumen por Rango de Fechas -->
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-dark">
            <div class="card-header bg-dark text-white fw-bold">
                3. Resumen por Rango de Fechas
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="ResumenRango">
                    <div class="mb-2">
                        <label class="form-label fw-semibold">Fecha Inicio:</label>
                        <input type="date" asp-for="FechaInicioRango" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold">Fecha Fin:</label>
                        <input type="date" asp-for="FechaFinRango" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo de Valores:</label>
                        <select asp-for="MostrarTotales" class="form-select">
                            <option value="true">Valores Totales (con IVA)</option>
                            <option value="false">Valores Sin IVA</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-dark w-100 fw-bold">Consultar Rango y Gráfica</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!--  SECCIÓN DE RESULTADOS, GRÁFICAS Y PDF  -->

@if (Model.ResultadoContribuyente != null)
{
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-danger fw-bold shadow-sm" onclick="descargarPdf('areaReporteContribuyente', 'Reporte_Contribuyente_@Model.ResultadoContribuyente.Nit')">
            📄 Descargar Reporte en PDF
        </button>
    </div>

    <div id="areaReporteContribuyente" class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white fw-bold">
            Reporte SAT: Consulta de Contribuyente (@Model.ResultadoContribuyente.TipoOperacion)
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4"><strong>NIT:</strong> @Model.ResultadoContribuyente.Nit</div>
                <div class="col-md-4"><strong>Nombre:</strong> @Model.ResultadoContribuyente.NombreContribuyente</div>
                <div class="col-md-4"><strong>Rango:</strong> @Model.ResultadoContribuyente.FechaInicio al @Model.ResultadoContribuyente.FechaFin</div>
            </div>

            <div class="alert alert-info fw-bold">
                Total Facturado en todo el Rango de Tiempo: Q @Model.ResultadoContribuyente.TotalFacturadoEnRango.ToString("N2")
            </div>

            <h5 class="fw-bold mt-3">Resumen por Fecha</h5>
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Cantidad de Facturas Autorizadas</th>
                        <th>Monto Total Facturado (Q)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ResultadoContribuyente.DetallePorFecha.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center">No se encontraron facturas autorizadas en este rango.</td></tr>
                    }
                    @foreach (var item in Model.ResultadoContribuyente.DetallePorFecha)
                    {
                        <tr>
                            <td>@item.Fecha</td>
                            <td>@item.CantidadFacturasAutorizadas</td>
                            <td>Q @item.MontoTotalFacturado.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h5 class="fw-bold mt-4">Listado Detallado de Facturas (@Model.ResultadoContribuyente.TipoOperacion)</h5>
            <table class="table table-sm table-bordered">
                <thead class="table-secondary">
                    <tr>
                        <th>Fecha y Hora</th>
                        <th>Referencia</th>
                        <th>Código Aprobación</th>
                        <th>NIT Emisor</th>
                        <th>NIT Receptor</th>
                        <th>Valor (Q)</th>
                        <th>IVA (Q)</th>
                        <th>Total (Q)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fac in Model.ResultadoContribuyente.ListadoFacturas)
                    {
                        <tr>
                            <td>@fac.Fecha @fac.Hora</td>
                            <td>@fac.Referencia</td>
                            <td><code>@fac.CodigoAprobacion</code></td>
                            <td>@fac.NitEmisor</td>
                            <td>@fac.NitReceptor</td>
                            <td>Q @fac.Valor.ToString("N2")</td>
                            <td>Q @fac.Iva.ToString("N2")</td>
                            <td class="fw-bold">Q @fac.Total.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.ResultadoResumenIva != null)
{
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-danger fw-bold shadow-sm" onclick="descargarPdf('areaReporteIva', 'Reporte_Resumen_IVA')">
            📄 Descargar Reporte en PDF
        </button>
    </div>

    <div id="areaReporteIva" class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white fw-bold">
            Reporte SAT: Resumen de Movimientos de IVA por NIT (Fecha: @Model.ResultadoResumenIva.Fecha)
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped mb-4">
                <thead class="table-dark">
                    <tr>
                        <th>NIT</th>
                        <th>Nombre del Contribuyente</th>
                        <th>IVA Emitido (Q)</th>
                        <th>IVA Recibido (Q)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ResultadoResumenIva.MovimientosPorNit.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center">No hubo movimientos autorizados en esta fecha.</td></tr>
                    }
                    @foreach (var mov in Model.ResultadoResumenIva.MovimientosPorNit)
                    {
                        <tr>
                            <td class="fw-bold">@mov.Nit</td>
                            <td>@mov.Nombre</td>
                            <td>Q @mov.IvaEmitido.ToString("N2")</td>
                            <td>Q @mov.IvaRecibido.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Gráfica 1: Resumen de IVA por Fecha y NIT -->
            <hr />
            <h5 class="fw-bold text-success mt-3 mb-3">Gráfica Comparativa: IVA Emitido vs. IVA Recibido (@Model.ResultadoResumenIva.Fecha)</h5>
            <div class="p-3 bg-white border rounded" style="max-height: 420px;">
                <canvas id="graficaIvaCanvas"></canvas>
            </div>
        </div>
    </div>
}

@if (Model.ResultadoResumenRango != null)
{
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-danger fw-bold shadow-sm" onclick="descargarPdf('areaReporteRango', 'Reporte_Rango_Fechas')">
            📄 Descargar Reporte en PDF
        </button>
    </div>

    <div id="areaReporteRango" class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white fw-bold">
            Reporte SAT: Resumen por Rango de Fechas (@Model.ResultadoResumenRango.FechaInicio al @Model.ResultadoResumenRango.FechaFin)
        </div>
        <div class="card-body">
            <h5 class="fw-bold">Valores Autorizados por Fecha (@(Model.ResultadoResumenRango.MostrarValoresTotales ? "Valores Totales con IVA" : "Valores Sin IVA"))</h5>
            <table class="table table-bordered table-striped mb-4">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Monto Autorizado (@(Model.ResultadoResumenRango.MostrarValoresTotales ? "Total" : "Sin IVA"))</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ResultadoResumenRango.ReportePorFechas.Count == 0)
                    {
                        <tr><td colspan="2" class="text-center">No hay registros en el rango seleccionado.</td></tr>
                    }
                    @foreach (var dia in Model.ResultadoResumenRango.ReportePorFechas)
                    {
                        <tr>
                            <td>@dia.Fecha</td>
                            <td class="fw-bold">Q @dia.ValorMostrado.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Gráfica 2: Resumen por Rango de Fechas -->
            <hr />
            <h5 class="fw-bold text-primary mt-3 mb-3">
                Gráfica de Valores Autorizados por Fecha (@(Model.ResultadoResumenRango.MostrarValoresTotales ? "Totales con IVA" : "Valores Sin IVA"))
            </h5>
            <div class="p-3 bg-white border rounded mb-4" style="max-height: 420px;">
                <canvas id="graficaRangoCanvas"></canvas>
            </div>

            <hr />
            <h5 class="fw-bold mt-3">Detalle Estadístico de Facturas Recibidas y Errores por Fecha</h5>
            <div class="table-responsive">
                <table class="table table-sm table-bordered table-hover text-center align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th>FECHA</th>
                            <th>Total Recibidas</th>
                            <th>NIT Emisor Inválido</th>
                            <th>NIT Receptor Inválido</th>
                            <th>NIT Emisor Inexistente</th>
                            <th>NIT Receptor Inexistente</th>
                            <th>IVA Mal Calculado</th>
                            <th>TOTAL Mal Calculado</th>
                            <th>REFERENCIA Duplicada</th>
                            <th>Facturas Sin Errores</th>
                            <th>Emisores Distintos</th>
                            <th>Receptores Distintos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.ResultadoResumenRango.ReportePorFechas)
                        {
                            <tr>
                                <td class="fw-bold">@d.Fecha</td>
                                <td>@d.CantidadTotalFacturasRecibidas</td>
                                <td class="text-danger">@d.ErrorNitEmisorInvalido</td>
                                <td class="text-danger">@d.ErrorNitReceptorInvalido</td>
                                <td class="text-danger">@d.ErrorNitEmisorInexistente</td>
                                <td class="text-danger">@d.ErrorNitReceptorInexistente</td>
                                <td class="text-danger">@d.ErrorIvaMalCalculado</td>
                                <td class="text-danger">@d.ErrorTotalMalCalculado</td>
                                <td class="text-danger">@d.ErrorReferenciaDuplicada</td>
                                <td class="text-success fw-bold">@d.CantidadFacturasSinErrores</td>
                                <td>@d.CantidadEmisoresDistintos</td>
                                <td>@d.CantidadReceptoresDistintos</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <!-- Librerías para Gráficas (Chart.js) y Exportación a PDF (html2pdf.js) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        // Función para exportar cualquier reporte (con su tabla y gráfica) a archivo PDF
        function descargarPdf(idContenedor, nombreArchivo) {
            const elemento = document.getElementById(idContenedor);
            const opciones = {
                margin: 8,
                filename: nombreArchivo + '.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
            };
            html2pdf().set(opciones).from(elemento).save();
        }
    </script>

    @if (Model.ResultadoResumenIva != null)
    {
        var etiquetasNits = JsonSerializer.Serialize(Model.ResultadoResumenIva.MovimientosPorNit.Select(m => $"{m.Nit} ({m.Nombre})"));
        var datosEmitido = JsonSerializer.Serialize(Model.ResultadoResumenIva.MovimientosPorNit.Select(m => m.IvaEmitido));
        var datosRecibido = JsonSerializer.Serialize(Model.ResultadoResumenIva.MovimientosPorNit.Select(m => m.IvaRecibido));

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const ctxIva = document.getElementById('graficaIvaCanvas');
                if (ctxIva) {
                    new Chart(ctxIva, {
                        type: 'bar',
                        data: {
                            labels: @Html.Raw(etiquetasNits),
                            datasets: [
                                {
                                    label: 'IVA Emitido (Q)',
                                    data: @Html.Raw(datosEmitido),
                                    backgroundColor: 'rgba(13, 110, 253, 0.75)',
                                    borderColor: 'rgb(13, 110, 253)',
                                    borderWidth: 1
                                },
                                {
                                    label: 'IVA Recibido (Q)',
                                    data: @Html.Raw(datosRecibido),
                                    backgroundColor: 'rgba(25, 135, 84, 0.75)',
                                    borderColor: 'rgb(25, 135, 84)',
                                    borderWidth: 1
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: { beginAtZero: true }
                            }
                        }
                    });
                }
            });
        </script>
    }

    @if (Model.ResultadoResumenRango != null)
    {
        var etiquetasFechas = JsonSerializer.Serialize(Model.ResultadoResumenRango.ReportePorFechas.Select(r => r.Fecha));
        var datosMontos = JsonSerializer.Serialize(Model.ResultadoResumenRango.ReportePorFechas.Select(r => r.ValorMostrado));
        var tituloSerie = Model.ResultadoResumenRango.MostrarValoresTotales ? "Monto Total Autorizado con IVA (Q)" : "Monto Autorizado Sin IVA (Q)";

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const ctxRango = document.getElementById('graficaRangoCanvas');
                if (ctxRango) {
                    new Chart(ctxRango, {
                        type: 'bar',
                        data: {
                            labels: @Html.Raw(etiquetasFechas),
                            datasets: [
                                {
                                    label: '@tituloSerie',
                                    data: @Html.Raw(datosMontos),
                                    backgroundColor: 'rgba(33, 37, 41, 0.8)',
                                    borderColor: 'rgb(33, 37, 41)',
                                    borderWidth: 1
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: { beginAtZero: true }
                            }
                        }
                    });
                }
            });
        </script>
    }
}