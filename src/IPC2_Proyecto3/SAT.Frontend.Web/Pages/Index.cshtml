@page
@model IndexModel
@{
    ViewData["Title"] = "Enviar Mensaje e Inicializar";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold text-primary">Gestión de Mensajes y Estado del Sistema</h2>
        <p class="text-muted">Carga archivos JSON para actualizar el RTU o autorizar facturas (DTE), o bien reinicia los datos almacenados en la API.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeEstado))
{
    <div class="alert @(Model.EsError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
        <strong>@(Model.EsError ? "Error:" : "¡Éxito!")</strong> @Model.MensajeEstado
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Componente 1: Enviar Mensaje JSON -->
    <div class="col-md-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white fw-bold">
                Enviar Mensaje al Servicio 2 (Archivo .json)
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data" asp-page-handler="Enviar">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo de Solicitud:</label>
                        <select asp-for="TipoOperacion" class="form-select">
                            <option value="auto">Detección Automática (/Procesar)</option>
                            <option value="rtu">Actualización de RTU (/Procesar/Rtu)</option>
                            <option value="facturas">Solicitud de Autorización de Facturas (/Procesar/Autorizaciones)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Seleccionar archivo JSON:</label>
                        <input type="file" asp-for="ArchivoJson" accept=".json" class="form-control" required />
                        <div class="form-text">Elige un archivo con extensión <code>.json</code> con una o varias solicitudes.</div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                        Enviar Solicitud a la API
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Componente 2: Opción Inicializar (Resetear datos) -->
    <div class="col-md-4">
        <div class="card shadow-sm border-danger h-100">
            <div class="card-header bg-danger text-white fw-bold">
                Opción Inicializar Sistema
            </div>
            <div class="card-body d-flex flex-column justify-content-between">
                <p class="text-muted">
                    Esta opción enviará un mensaje a la API para devolver el sistema a su estado inicial (sin datos de RTU, facturas ni correlativos).
                </p>
                <form method="post" asp-page-handler="Resetear" onsubmit="return confirm('¿Estás seguro de que deseas borrar todos los datos y devolver el sistema al estado inicial?');">
                    <button type="submit" class="btn btn-outline-danger w-100 fw-bold">
                        Resetear Datos (Inicializar)
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.RespuestaJsonFormateada))
{
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-dark">
                <div class="card-header bg-dark text-white fw-bold">
                    Respuesta Recibida del Servicio 2 (JSON)
                </div>
                <div class="card-body bg-light">
                    <pre class="mb-0 text-dark fw-semibold" style="max-height: 400px; overflow-y: auto;">@Model.RespuestaJsonFormateada</pre>
                </div>
            </div>
        </div>
    </div>
}